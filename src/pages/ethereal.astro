---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import Lightbox from '../components/Lightbox.astro';
import { thumb } from '../data/images';
import { BREVO_FORM_URL } from '../data/site';
import '../styles/gallery.css';

const project = await getEntry('portfolio', 'ethereal-a-tale-an-original-graphic-novel-by-craig-gilmore');
const images = project?.data.images ?? [];
---

<BaseLayout
  title="Ethereal: A Tale — Craig Gilmore"
  description="Ethereal: A Tale, an original graphic novel by Craig Gilmore. See preview art and sign up to hear about the release and Kickstarter launch."
>
  <PageBanner
    label="Graphic Novel"
    title="Ethereal: A Tale"
    note="An original graphic novel by Craig Gilmore."
    image={thumb('/content/uploads/2022/06/FinalPromo03ColorNewLogoSMALL-1.jpg').src}
    imagePosition="center 35%"
  />

  <section class="ethereal-section ethereal-page-intro" aria-label="About Ethereal: A Tale">
    <div class="container">
      <div class="ethereal-inner">
        <div class="ethereal-visual reveal">
          <img class="ethereal-logo-img" src="/images/ethereal-logo-final.jpg" alt="Ethereal: A Tale logo" />
        </div>

        <div class="ethereal-content" id="signup">
          <div class="ethereal-badge">
            <span class="pulse-dot" aria-hidden="true"></span>
            Now in Development
          </div>
          <p class="section-label reveal">Be the First to Know</p>
          <h2 class="ethereal-title reveal reveal-delay-1">Get Release<br />Updates</h2>
          <p class="ethereal-desc reveal reveal-delay-2">
            Craig's most ambitious creative work to date. Sign up to hear about the progress and publication of <em>Ethereal: A Tale</em> — preview art drops, the official release announcement and the Kickstarter launch.
          </p>
          {BREVO_FORM_URL ? (
            <form class="signup-form reveal reveal-delay-3" method="post" action={BREVO_FORM_URL}>
              <div class="signup-fields">
                <label class="signup-field">
                  <span>First name</span>
                  <input type="text" name="FIRSTNAME" autocomplete="given-name" maxlength="200" required />
                </label>
                <label class="signup-field">
                  <span>Email</span>
                  <input type="email" name="EMAIL" autocomplete="email" required />
                </label>
              </div>
              <!-- Honeypot: Brevo rejects submissions where this hidden field is filled in. -->
              <input class="signup-hp" type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off" aria-hidden="true" />
              <input type="hidden" name="locale" value="en" />
              <button type="submit" class="btn btn-primary">Get Notified of Release</button>
              <p class="signup-error" role="alert" hidden></p>
              <p class="signup-note">You'll get an email to confirm. No spam, and you can unsubscribe any time.</p>
            </form>
          ) : (
            <div class="reveal reveal-delay-3">
              <a href="mailto:craig@craiggilmore.net?subject=Ethereal%3A%20A%20Tale%20updates" class="btn btn-primary">Get Notified of Release</a>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  {images.length > 0 && (
    <section class="gallery-section">
      <div class="container">
        <div class="project-header">
          <h2 class="project-title">Preview Art</h2>
          <span class="project-meta">Promotional illustrations</span>
        </div>
        <div class="img-grid img-grid--natural ethereal-grid">
          {images.map((img, i) => (
            <div class="img-item" data-src={img.src} data-caption={img.caption || `Ethereal: A Tale — preview ${i + 1}`}>
              <img {...thumb(img.src)} alt={img.caption || `Ethereal: A Tale preview art ${i + 1}`} loading="lazy" decoding="async" />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <Lightbox />
</BaseLayout>

<script>
  // Submit the Brevo form in the background, then show our own thank-you page on this
  // domain. Without JavaScript, or if the request can't be made, the form posts straight
  // to Brevo instead and Brevo shows its own confirmation.
  const form = document.querySelector<HTMLFormElement>('.signup-form');
  if (form) {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const error = form.querySelector<HTMLElement>('.signup-error')!;
    const label = button.textContent;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      error.hidden = true;
      button.disabled = true;
      button.textContent = 'Signing you up…';

      const url = new URL(form.action);
      url.searchParams.set('isAjax', '1');

      let result: { success?: boolean; message?: unknown; errors?: Record<string, unknown> };
      try {
        const response = await fetch(url, { method: 'POST', body: new FormData(form) });
        result = await response.json();
      } catch {
        form.submit();
        return;
      }

      if (result.success) {
        window.location.assign('/ethereal/thanks/');
        return;
      }

      const detail = [result.message, ...Object.values(result.errors ?? {})].find((m) => typeof m === 'string');
      error.textContent = typeof detail === 'string' ? detail : "Sorry, that didn't go through. Please check your details and try again.";
      error.hidden = false;
      button.disabled = false;
      button.textContent = label;
    });
  }
</script>

<style is:global>
  .ethereal-page-intro { border-bottom: 1px solid var(--border); }
  .ethereal-logo-img { width: 100%; border-radius: 4px; display: block; }
  /* Masonry: CSS columns everywhere, native grid lanes where supported. */
  .ethereal-grid { display: block; columns: 3 280px; column-gap: 0.75rem; }
  .ethereal-grid > .img-item { break-inside: avoid; margin-block-end: 0.75rem; }
  @supports (display: grid-lanes) {
    .ethereal-grid {
      display: grid-lanes;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 0.75rem;
      columns: auto;
    }
    .ethereal-grid > .img-item { margin-block-end: 0; }
  }

  .signup-form { max-width: 520px; }
  .signup-fields {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .signup-field { display: flex; flex-direction: column; gap: 0.4rem; }
  .signup-field span {
    font-family: var(--font-cond);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .signup-field em { font-style: normal; font-weight: 400; color: var(--text-dim); }
  .signup-field input {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--border-hi);
    border-radius: 3px;
    padding: 0.75rem 0.875rem;
    color: var(--text);
    font: inherit;
    font-size: 0.9375rem;
    transition: border-color 0.15s;
  }
  .signup-field input:focus { outline: none; border-color: var(--accent); }
  .signup-hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .signup-error { margin-top: 0.875rem; font-size: 0.875rem; color: var(--accent-hi); }
  .signup-note { margin-top: 0.875rem; font-size: 0.8125rem; color: var(--text-muted); }
  @media (max-width: 560px) {
    .signup-fields { grid-template-columns: 1fr; }
    .signup-form .btn { width: 100%; justify-content: center; }
  }
</style>
